# Copy this file to a private location outside the repository.
# Replace every placeholder with your own local connection details.

[ops_servers]
ops-server ansible_host=REPLACE_WITH_VM_IP

[ops_servers:vars]
ansible_user=REPLACE_WITH_ADMIN_SSH_USER
ansible_ssh_private_key_file=REPLACE_WITH_ABSOLUTE_PATH_TO_PRIVATE_KEY
ansible_ssh_common_args='-o IdentitiesOnly=yes'
ansible_python_interpreter=/usr/bin/python3
