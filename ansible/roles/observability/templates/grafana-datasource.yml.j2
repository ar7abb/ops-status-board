apiVersion: 1

# Replace the earlier UI-created datasource so the stable UID below exists
# before the provisioned dashboard is loaded.
deleteDatasources:
  - name: Prometheus
    orgId: 1
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false