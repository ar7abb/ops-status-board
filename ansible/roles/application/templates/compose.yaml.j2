name: ops-status-board

services:
  db:
    image: {{ ops_postgres_image }}
    mem_limit: 512m
    cpus: 0.50
    env_file:
      - {{ ops_secret_dir }}/postgres.env
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 10s

  app:
    image: {{ ops_application_image }}
    mem_limit: 512m
    cpus: 0.50
    env_file:
      - {{ ops_secret_dir }}/app.env
    ports:
      - "127.0.0.1:8000:8000"
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 15s

  migrate:
    profiles: ["maintenance"]
    image: {{ ops_application_image }}
    env_file:
      - {{ ops_secret_dir }}/app.env
    depends_on:
      db:
        condition: service_healthy
    command: ["alembic", "upgrade", "head"]

  prometheus:
    image: {{ ops_prometheus_image }}
    mem_limit: {{ ops_prometheus_memory_limit }}
    cpus: {{ ops_prometheus_cpu_limit }}
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ ops_prometheus_retention_time }}"
      - "--storage.tsdb.retention.size={{ ops_prometheus_retention_size }}"
    volumes:
      - "{{ ops_prometheus_config_file }}:/etc/prometheus/prometheus.yml:ro"
      - "{{ ops_prometheus_metrics_token_file }}:/run/secrets/ops-status-board-metrics-token:ro"
      - "{{ ops_prometheus_data_dir }}:/prometheus"
    restart: unless-stopped

  grafana:
    image: {{ ops_grafana_image }}
    mem_limit: {{ ops_grafana_memory_limit }}
    cpus: {{ ops_grafana_cpu_limit }}
    env_file:
      - {{ ops_grafana_env_file }}
    ports:
      - "{{ ops_grafana_bind_address }}"
    volumes:
      - "{{ ops_grafana_data_dir }}:/var/lib/grafana"
      - "{{ ops_grafana_provisioning_dir }}:/etc/grafana/provisioning:ro"
    depends_on:
      prometheus:
        condition: service_started
    restart: unless-stopped

volumes:
  postgres-data:
