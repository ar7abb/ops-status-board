{
  "agent": {
    "metrics_collection_interval": {{ ops_cloudwatch_metrics_interval_seconds }},
    "region": "{{ ops_cloudwatch_region }}",
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "drop_device": true,
        "measurement": ["used_percent"],
        "metrics_collection_interval": {{ ops_cloudwatch_metrics_interval_seconds }},
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["available_percent"],
        "metrics_collection_interval": {{ ops_cloudwatch_metrics_interval_seconds }}
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/ops-status-board.access.log",
            "log_group_name": "{{ ops_cloudwatch_access_log_group }}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "{{ ops_cloudwatch_error_log_group }}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
